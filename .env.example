# Copy to .env. Add OPENAI_API_KEY to enable generated answers.
# Without a key the app returns keyword-ranked excerpts, not synthesized answers.
OPENAI_API_KEY=
# Set to "ollama" to generate answers and embeddings entirely on this machine.
AI_PROVIDER=openai
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
CHAT_MODEL=gpt-4.1-mini
EMBED_MODEL=text-embedding-3-small
# Local defaults use SQLite and local files. Docker Compose supplies PostgreSQL.
# DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
DATA_DIR=./data
MAX_FILE_MB=250
INLINE_WORKER=true
# Enable behind HTTPS in production.
COOKIE_SECURE=false

# Optional read-only Gmail integration. Register a Google OAuth Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
# Drive OAuth uses the same Google Web application, with its own redirect URI.
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/drive/callback
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GMAIL_TOKEN_ENCRYPTION_KEY=

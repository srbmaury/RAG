{
  "name": "atlas-document-intelligence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "format": "prettier --config .prettierrc.json --write \"{app,components,e2e,hooks,lib,tests,utils}/**/*.{ts,tsx,js,jsx,mjs,css}\" next.config.ts playwright.config.ts ../compose.yaml \"../.github/workflows/*.{yml,yaml}\"",
    "format:check": "prettier --config .prettierrc.json --check \"{app,components,e2e,hooks,lib,tests,utils}/**/*.{ts,tsx,js,jsx,mjs,css}\" next.config.ts playwright.config.ts ../compose.yaml \"../.github/workflows/*.{yml,yaml}\""
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "prettier": "^3.6.2"
  }
}
